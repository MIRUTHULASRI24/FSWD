import { useState } from "react";

export default function App() {
  const [profile, setProfile] = useState({
    name: "",
    email: "",
    phone: "",
  });

  const [errors, setErrors] = useState({});

  // Validate inputs
  const validate = () => {
    const errors = {};

    if (!profile.name.trim()) {
      errors.name = "Name is required";
    }

    if (!profile.email.trim()) {
      errors.email = "Email is required";
    } else if (
      !/^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i.test(profile.email)
    ) {
      errors.email = "Invalid email address";
    }

    if (!profile.phone.trim()) {
      errors.phone = "Phone number is required";
    } else if (!/^\d{10}$/.test(profile.phone)) {
      errors.phone = "Phone number must be 10 digits";
    }

    return errors;
  };

  const handleChange = (e) => {
    setProfile({ ...profile, [e.target.name]: e.target.value });
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    const validationErrors = validate();
    setErrors(validationErrors);

    if (Object.keys(validationErrors).length === 0) {
      alert("Profile updated successfully!");
      // Here you can also send data to backend or save locally
    }
  };

  return (
    <div
      style={{
        maxWidth: 400,
        margin: "20px auto",
        fontFamily: "Arial",
        padding: 20,
        border: "1px solid #ccc",
        borderRadius: 6,
      }}
    >
      <h2>Edit User Profile</h2>
      <form onSubmit={handleSubmit} noValidate>
        {/* Name */}
        <div style={{ marginBottom: 15 }}>
          <label>
            Name:<br />
            <input
              type="text"
              name="name"
              value={profile.name}
              onChange={handleChange}
              style={{
                width: "100%",
                padding: 8,
                borderColor: errors.name ? "red" : "#ccc",
                borderRadius: 4,
              }}
            />
          </label>
          {errors.name && (
            <div style={{ color: "red", marginTop: 4 }}>{errors.name}</div>
          )}
        </div>

        {/* Email */}
        <div style={{ marginBottom: 15 }}>
          <label>
            Email:<br />
            <input
              type="email"
              name="email"
              value={profile.email}
              onChange={handleChange}
              style={{
                width: "100%",
                padding: 8,
                borderColor: errors.email ? "red" : "#ccc",
                borderRadius: 4,
              }}
            />
          </label>
          {errors.email && (
            <div style={{ color: "red", marginTop: 4 }}>{errors.email}</div>
          )}
        </div>

        {/* Phone */}
        <div style={{ marginBottom: 15 }}>
          <label>
            Phone Number:<br />
            <input
              type="text"
              name="phone"
              value={profile.phone}
              onChange={handleChange}
              maxLength={10}
              style={{
                width: "100%",
                padding: 8,
                borderColor: errors.phone ? "red" : "#ccc",
                borderRadius: 4,
              }}
            />
          </label>
          {errors.phone && (
            <div style={{ color: "red", marginTop: 4 }}>{errors.phone}</div>
          )}
        </div>

        <button
          type="submit"
          style={{
            width: "100%",
            padding: 10,
            backgroundColor: "#4caf50",
            color: "white",
            border: "none",
            borderRadius: 5,
            cursor: "pointer",
          }}
        >
          Save Profile
        </button>
      </form>
    </div>
  );
}
