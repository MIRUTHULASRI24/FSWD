import { useState } from "react";

export default function App() {
  const [formData, setFormData] = useState({
    fullName: "",
    email: "",
    workshop: "",
    experience: "",
  });

  const workshops = [
    "React Basics",
    "Advanced JavaScript",
    "UI/UX Design",
    "Node.js & Express",
  ];

  function handleChange(e) {
    const { name, value } = e.target;
    setFormData((prev) => ({ ...prev, [name]: value }));
  }

  return (
    <div style={{ maxWidth: 600, margin: "30px auto", fontFamily: "Arial, sans-serif" }}>
      <h2>Online Workshop Registration</h2>

      <form
        onSubmit={(e) => {
          e.preventDefault();
          alert(`Thank you, ${formData.fullName}! You have registered for ${formData.workshop}.`);
        }}
        style={{ marginBottom: 30 }}
      >
        {/* Full Name */}
        <div style={{ marginBottom: 15 }}>
          <label>
            Full Name:<br />
            <input
              type="text"
              name="fullName"
              value={formData.fullName}
              onChange={handleChange}
              required
              placeholder="Enter your full name"
              style={{ width: "100%", padding: 8, borderRadius: 4, border: "1px solid #ccc" }}
            />
          </label>
        </div>

        {/* Email */}
        <div style={{ marginBottom: 15 }}>
          <label>
            Email:<br />
            <input
              type="email"
              name="email"
              value={formData.email}
              onChange={handleChange}
              required
              placeholder="Enter your email"
              style={{ width: "100%", padding: 8, borderRadius: 4, border: "1px solid #ccc" }}
            />
          </label>
        </div>

        {/* Workshop Selection */}
        <div style={{ marginBottom: 15 }}>
          <label>
            Select Workshop:<br />
            <select
              name="workshop"
              value={formData.workshop}
              onChange={handleChange}
              required
              style={{ width: "100%", padding: 8, borderRadius: 4, border: "1px solid #ccc" }}
            >
              <option value="">-- Select a workshop --</option>
              {workshops.map((ws, idx) => (
                <option key={idx} value={ws}>
                  {ws}
                </option>
              ))}
            </select>
          </label>
        </div>

        {/* Experience */}
        <div style={{ marginBottom: 15 }}>
          <label>
            Prior Experience:<br />
            <textarea
              name="experience"
              value={formData.experience}
              onChange={handleChange}
              placeholder="Describe your prior experience (optional)"
              rows={4}
              style={{ width: "100%", padding: 8, borderRadius: 4, border: "1px solid #ccc" }}
            />
          </label>
        </div>

        <button
          type="submit"
          style={{
            padding: "10px 15px",
            backgroundColor: "#007bff",
            color: "white",
            border: "none",
            borderRadius: 5,
            cursor: "pointer",
          }}
        >
          Register
        </button>
      </form>

      {/* Live Preview */}
      <div style={{ padding: 20, border: "1px solid #ddd", borderRadius: 6, backgroundColor: "#f9f9f9" }}>
        <h3>Live Preview</h3>
        <p>
          <strong>Name:</strong> {formData.fullName || <em>Not entered</em>}
        </p>
        <p>
          <strong>Email:</strong> {formData.email || <em>Not entered</em>}
        </p>
        <p>
          <strong>Workshop:</strong> {formData.workshop || <em>Not selected</em>}
        </p>
        <p>
          <strong>Experience:</strong> {formData.experience || <em>None provided</em>}
        </p>
      </div>
    </div>
  );
}
